# Copy to .env for local runs. Never commit the real .env.

# Postgres (docker compose default below works out of the box)
DATABASE_URL=postgresql+psycopg2://resolvedesk:resolvedesk@localhost:5432/resolvedesk

# LLM: stub is default and key-free. For real generation:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Risk gate
AUTO_RESOLVE_THRESHOLD=0.80

# Console API token (prototype auth - see DESIGN.md)
API_TOKEN=dev-token

# --- Real adapters (all optional; the app runs fully without them) ---
# Real email intake (IMAP):
# RD_IMAP_HOST=imap.gmail.com
# RD_IMAP_USER=you@gmail.com
# RD_IMAP_PASSWORD=app-password
# Real email sending (SMTP):
# RD_SMTP_HOST=smtp.gmail.com
# RD_SMTP_USER=you@gmail.com
# RD_SMTP_PASSWORD=app-password
# Real refunds (Stripe):
# STRIPE_API_KEY=sk_test_...
# RD_STRIPE_TEST_CHARGE=ch_...
